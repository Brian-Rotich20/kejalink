# KejaLink backend environment. Copy to .env and fill in. Never commit .env.

# development | production | test
NODE_ENV=development
# Interface to bind. Default: 127.0.0.1 in development, 0.0.0.0 in production.
HOST=0.0.0.0
PORT=5000
# Optional pino level: fatal|error|warn|info|debug|trace|silent (default: info, silent in test)
LOG_LEVEL=

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Local: create the database first (createdb kejalink). Managed: copy from your provider.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/kejalink

# Random secret, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Public base URL of THIS API (no trailing slash). Must be https:// in production.
BETTER_AUTH_URL=http://localhost:5000
# Browser origin(s) of the frontend, comma-separated (CORS + auth trusted origins).
FRONTEND_URL=http://localhost:3000

# Reverse-proxy hops in front of the API (client IP / rate limiting).
# Default: 1 in production, 0 in development. Never higher than your real proxy count.
TRUST_PROXY=
# Max requests per minute per IP for /api/auth/* (default 10).
AUTH_RATE_LIMIT_MAX=
# true = apply pending migrations when the server boots (use on hosts without a
# pre-deploy step, e.g. Render's free plan). Default false.
MIGRATE_ON_START=
# true = frontend and API are on different sites (e.g. *.vercel.app + *.onrender.com):
# session cookies become SameSite=None; Secure; Partitioned. Needs an https BETTER_AUTH_URL.
# Leave false when both share a domain (kejalink.co.ke + api.kejalink.co.ke).
CROSS_SITE_COOKIES=

# Cloudinary (property images). Dashboard -> Settings -> API Keys (https://console.cloudinary.com).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only read by `npm run seed:admin` (first admin account). Password min 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
