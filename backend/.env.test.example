# Copy to .env.test for `npm test`. Tests only ever use TEST_DATABASE_URL and refuse
# to run unless the database name contains "test". Everything else is set by tests/setup.
#
# Throwaway database with Docker:
#   docker run -d --name kejalink-test-pg -e POSTGRES_PASSWORD=test -e POSTGRES_DB=kejalink_test -p 127.0.0.1:56543:5432 postgres:17-alpine
TEST_DATABASE_URL=postgresql://postgres:test@127.0.0.1:56543/kejalink_test
