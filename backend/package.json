{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "npx @better-auth/cli generate --config src/config/auth/better-auth.ts --output .drizzle/auth.generated.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:watch": "vitest",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:admin:prod": "node dist/scripts/seed-admin.js",
    "db:migrate:prod": "node dist/scripts/migrate.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "KejaLink backend API",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.0",
    "better-auth": "^1.7.5",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
